# Copy this file to `.env`, then replace placeholders with real values.
# Never commit `.env` or paste your API key into source code.

# LLM provider used by the Phase 5 plain-Python router.
# Supported Phase 5 choices: openai or gemini.
LLM_PROVIDER=openai

# Create an API key in your provider account and place it only in `.env`.
OPENAI_API_KEY=replace-with-your-openai-api-key

# Budget-friendly OpenAI default for Phase 5 routing.
LLM_MODEL=gpt-4o-mini

# Gemini alternative:
# 1. Change LLM_PROVIDER above to gemini.
# 2. Add your Gemini key below.
# 3. Set LLM_MODEL above to a Gemini model available to your account.
GEMINI_API_KEY=replace-with-your-gemini-api-key

# Routing should be deterministic so evaluation results are reproducible.
LLM_TEMPERATURE=0

# The router retries malformed JSON once, as required by Phase 5.
LLM_JSON_RETRY_LIMIT=1

# Prevent an agent loop from calling tools indefinitely.
LLM_MAX_TOOL_CALLS=3

# Delay between evaluation calls. OpenAI paid API usually does not need the
# long Gemini free-tier delay, but keep this above 0 if you hit rate limits.
LLM_EVAL_DELAY_SECONDS=1.0

# Optional: uncomment only when using an OpenAI-compatible custom endpoint.
# OPENAI_BASE_URL=https://your-compatible-endpoint.example/v1
