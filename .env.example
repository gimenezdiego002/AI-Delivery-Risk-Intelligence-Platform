# Copy this file to `.env`, then replace placeholders with real values.
# Never commit `.env` or paste your API key into source code.

# LLM provider used by the Phase 5 plain-Python router.
# Supported Phase 5 choices: openai or gemini.
LLM_PROVIDER=openai

# Create an API key in your provider account and place it only in `.env`.
OPENAI_API_KEY=replace-with-your-openai-api-key

# Budget-friendly OpenAI default for Phase 5 routing.
LLM_MODEL=gpt-4o-mini

# Gemini alternative:
# 1. Change LLM_PROVIDER above to gemini.
# 2. Add your Gemini key below.
# 3. Set LLM_MODEL above to a Gemini model available to your account.
GEMINI_API_KEY=replace-with-your-gemini-api-key

# Routing should be deterministic so evaluation results are reproducible.
LLM_TEMPERATURE=0

# Explicit timeout for each external provider request.
LLM_TIMEOUT_SECONDS=30

# Bounded retries for transient network, rate-limit, and provider-server errors.
LLM_MAX_RETRIES=2

# Structured-output correction is separate from network retries.
LLM_JSON_RETRY_LIMIT=1

# Prevent an agent loop from calling tools indefinitely.
LLM_MAX_TOOL_CALLS=3

# Delay between evaluation calls. OpenAI paid API usually does not need the
# long Gemini free-tier delay, but keep this above 0 if you hit rate limits.
LLM_EVAL_DELAY_SECONDS=1.0

# Optional: uncomment only when using an OpenAI-compatible custom endpoint.
# OPENAI_BASE_URL=https://your-compatible-endpoint.example/v1

# Application environment: development, test, or production.
# Production validates that authentication and the selected provider key exist.
APP_ENV=development

# DEBUG, INFO, WARNING, ERROR, or CRITICAL.
LOG_LEVEL=INFO

# Local development may explicitly disable API-key authentication.
# Production requires API_AUTH_ENABLED=true and a non-empty API_KEY.
API_AUTH_ENABLED=false
API_KEY=replace-with-a-long-random-backend-api-key

# Streamlit uses these server-side when calling a protected deployed API.
API_BASE_URL=http://127.0.0.1:8000
API_REQUEST_TIMEOUT_SECONDS=30

# Lightweight single-process rate limiting. A shared store would be needed
# across multiple containers or replicas.
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_LLM_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# Leave empty for the current server-side Streamlit architecture. If a future
# browser client needs CORS, provide explicit comma-separated origins.
CORS_ALLOWED_ORIGINS=
